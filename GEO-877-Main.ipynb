    "def check_br_in_park(park_polygon, br_points):\n",
    "    # Check if any Brunnen points are inside the park polygon\n",
    "    for br in br_points:\n",
    "        if park_polygon.containsPoint(br):\n",
    "            return \"Yes\"\n",
    "    return \"No\"\n",
    "\n",
    "# Extract BR geometries as Point objects \n",
    "br_points = [Point(br.x, br.y) for br in gdf_br.geometry]\n",
    "\n",
    "# Create a new column in the parks DataFrame to store the result\n",
    "filtered_parks_combined['BR'] = filtered_parks_combined['parsed_geometry'].apply(\n",
    "    lambda park_geom: check_br_in_park(\n",
    "        Polygon(\n",
    "            data=[coord for sublist in park_geom for coord in sublist] if isinstance(park_geom[0], list) else park_geom,\n",
    "            xcol=0,\n",
    "            ycol=1\n",
    "        ),\n",
    "        br_points\n",
    "    )\n",
    ")\n",
    "\n",
    "parks_with_br = filtered_parks_combined[filtered_parks_combined['BR'] == 'Yes']\n",
