    "#compare bounding boxes to skip non-intersecting polygons\n",
    "def get_bbox(points):\n",
    "    xs = [p[0] for p in points]\n",
    "    ys = [p[1] for p in points]\n",
    "    return (min(xs), min(ys), max(xs), max(ys))  # (xmin, ymin, xmax, ymax)\n",
    "\n",
    "def bboxes_intersect(b1, b2):\n",
    "    return not (b1[2] < b2[0] or b1[0] > b2[2] or b1[3] < b2[1] or b1[1] > b2[3])\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 43,
   "metadata": {},
   "outputs": [],
   "source": [
    "#edge intersection\n",
    "def edges(poly):\n",
    "    return [(poly[i], poly[(i+1)%len(poly)]) for i in range(len(poly))]\n",
    "\n",
    "def ccw(a, b, c):\n",
    "    return (c[1]-a[1])*(b[0]-a[0]) > (b[1]-a[1])*(c[0]-a[0])\n",
    "\n",
    "def segments_intersect(p1, p2, q1, q2):\n",
    "    return ccw(p1, q1, q2) != ccw(p2, q1, q2) and ccw(p1, p2, q1) != ccw(p1, p2, q2)\n",
    "\n",
    "def polygons_intersect(poly1, poly2):\n",
    "    for e1 in edges(poly1):\n",
    "        for e2 in edges(poly2):\n",
    "            if segments_intersect(e1[0], e1[1], e2[0], e2[1]):\n",
    "                return True\n",
    "    return False\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 44,
   "metadata": {},
   "outputs": [],
   "source": [
    "def point_in_poly(point, poly):\n",
    "    x, y = point\n",
    "    inside = False\n",
    "    n = len(poly)\n",
    "    j = n - 1\n",
    "    for i in range(n):\n",
    "        xi, yi = poly[i]\n",
    "        xj, yj = poly[j]\n",
    "        if ((yi > y) != (yj > y)) and (x < (xj - xi) * (y - yi) / (yj - yi + 1e-12) + xi):\n",
    "            inside = not inside\n",
    "        j = i\n",
    "    return inside\n",
    "\n",
    "def parks_in_quartier_optimized(quartier_coords):\n",
    "    bbox_q = get_bbox(quartier_coords)\n",
    "    edges_q = edges(quartier_coords)\n",
    "    intersecting = []\n",
    "    for park_name, park_poly in park_polygons:\n",
    "        bbox_p = get_bbox(park_poly.points)\n",
    "        if not bboxes_intersect(bbox_q, bbox_p):\n",
    "            continue\n",
    "        if polygons_intersect(quartier_coords, park_poly.points):\n",
    "            intersecting.append(park_name)\n",
    "        elif any(point_in_poly(p, quartier_coords) for p in park_poly.points):\n",
    "            intersecting.append(park_name)\n",
    "        elif any(point_in_poly(p, park_poly.points) for p in quartier_coords):\n",
    "            intersecting.append(park_name)\n",
    "    return intersecting\n"
   ]
  },
