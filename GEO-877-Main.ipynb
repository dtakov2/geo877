    "import rasterio\n",
    "# read chm dataset\n",
    "def read_treeheight(treeheight_path):\n",
    "    with rasterio.open(treeheight_path) as src:\n",
    "        treeheight = src.read(1)  # Read the first band\n",
    "        transform = src.transform  # Get the affine transform\n",
    "        rows, cols = treeheight.shape  # Get the dimensions of the raster\n",
    "\n",
    "    # extract coordinates and tree heights\n",
    "    tree_coord = []\n",
    "    for row in range(rows):\n",
    "        for col in range(cols):\n",
    "            height = treeheight[row, col]\n",
    "            if height > 0: # filter out non-tree pixels\n",
    "                x, y = rasterio.transform.xy(transform, row, col)\n",
    "                tree_coord.append((x, y, height))\n",
    "    return tree_coord\n",
    "        \n",
    "# point in polygon approach to assign the trees to the corresponing parks\n",
    "def tree_in_park(tree_coord, dfParks): # check what the name of the park dataset is!!!!\n",
    "    park_height_average = []\n",
    "    for _, park in dfParks.iterrows():\n",
    "        park_polygon = Polygon(park['geometry'], xcol=0, ycol=1)  # Create a Polygon object for the park\n",
    "        tree_heights = []\n",
    "\n",
    "        for x, y, height in tree_coord:\n",
    "            tree_point = Point(x, y)\n",
    "            if park_polygon.containsPoint(tree_point):\n",
    "                tree_heights.append(height)\n",
    "\n",
    "        # calculate average tree height\n",
    "        avg_height = sum(tree_heights) / len(tree_heights) if tree_heights else 0\n",
    "        park_height_average.append(avg_height)\n",
    "    # add avg_height as a new column to the park dataframe\n",
    "    dfParks['avg_tree_height'] = avg_tree_height\n",
    "    return dfParks\n",
    "\n",
    "# main workflow\n",
