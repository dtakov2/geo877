    "class Polygon(PointGroup):\n",
    "\n",
    "    # Check if a point (p) is inside the polygon using ray-casting algorithm\n",
    "    def containsPoint(self, p):\n",
    "        n = self.size\n",
    "        inside = False\n",
    "        p1x, p1y = self[0].x, self[0].y\n",
    "        for i in range(n + 1):\n",
    "            p2x, p2y = self[i % n].x, self[i % n].y\n",
    "            if p.y > min(p1y, p2y):\n",
    "                if p.y <= max(p1y, p2y):\n",
    "                    if p.x <= max(p1x, p2x):\n",
    "                        if p1y != p2y:\n",
    "                            xinters = (p.y - p1y) * (p2x - p1x) / (p2y - p1y) + p1x\n",
    "                        if p1x == p2x or p.x <= xinters:\n",
    "                            inside = not inside\n",
    "            p1x, p1y = p2x, p2y\n",
    "        return inside\n"
   ]
  },
