    "def check_wc_in_park(park_polygon, wc_points):\n",
    "    # Check if any WC point is inside the park polygon\n",
    "    for wc in wc_points:\n",
    "        if park_polygon.containsPoint(wc):\n",
    "            return \"Yes\"\n",
    "    return \"No\"\n",
    "\n",
    "# Extract WC geometries as Point objects (ensure WC data is in Point form)\n",
    "wc_points = [Point(wc.x, wc.y) for wc in gdf_wc.geometry]\n",
    "\n",
    "# Create a new column in the parks DataFrame to store the result\n",
    "filtered_parks_combined['WC'] = filtered_parks_combined['parsed_geometry'].apply(\n",
    "    lambda park_geom: check_wc_in_park(\n",
    "        Polygon(\n",
    "            data=[coord for sublist in park_geom for coord in sublist] if isinstance(park_geom[0], list) else park_geom,\n",
    "            xcol=0,\n",
    "            ycol=1\n",
    "        ),\n",
    "        wc_points\n",
    "    )\n",
    ")\n",
    "\n",
    "parks_with_wc = filtered_parks_combined[filtered_parks_combined['WC'] == 'Yes']\n",
    "\n",
    "# View the updated parks DataFrame with the new column\n",
    "print(filtered_parks_combined['WC'].value_counts())"
