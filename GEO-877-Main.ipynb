    "\n",
    "# calculate proportions\n",
    "dfParks_with_water['green_area'] = dfParks_with_water['park_area'] - dfParks_with_water['water_area']\n",
    "dfParks_with_water['green_ratio'] = dfParks_with_water['green_area'] / dfParks_with_water['park_area']\n",
    "dfParks_with_water['blue_ratio'] = dfParks_with_water['water_area'] / dfParks_with_water['park_area']\n",
