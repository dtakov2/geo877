    "def combine_polygons_greiner_hormann(geometries):\n",
    "\n",
    "    flattened = []\n",
    "    for geom in geometries:\n",
    "        if isinstance(geom, MultiPolygon):\n",
    "            flattened.extend(geom.geoms)\n",
    "        else:\n",
    "            flattened.append(geom)\n",
    "\n",
    "    repaired = [geom.buffer(0) if not geom.is_valid else geom for geom in flattened]\n",
    "\n",
    "    combined = repaired[0]\n",
    "    for geom in repaired[1:]:\n",
    "        combined = combined.union(geom)\n",
    "\n",
    "    # Remove holes from the combined geometry\n",
    "    if isinstance(combined, Polygon):\n",
    "        combined = Polygon(combined.exterior)\n",
    "    elif isinstance(combined, MultiPolygon):\n",
    "        combined = MultiPolygon([Polygon(poly.exterior) for poly in combined.geoms])\n",
    "\n",
    "    return combined\n",
    "\n",
    "def combine_polygons_by_attribute(geodataframe, attribute):\n",
    "\n",
    "    combined_geometries = []\n",
    "\n",
    "    for group_name, group in geodataframe.groupby(attribute):\n",
    "        geometries = group['geometry'].tolist()\n",
    "        combined_geometry = combine_polygons_greiner_hormann(geometries)\n",
    "        combined_geometries.append({'pflegeareal': group_name, 'geometry': combined_geometry})\n",
    "\n",
    "    return gpd.GeoDataFrame(combined_geometries, crs=geodataframe.crs)\n",
    "\n",
    "parks_combined = combine_polygons_by_attribute(parks, 'pflegeareal') #use the combination algorithm on the geodataframe to combine by pflegeareal\n",
    "\n",
    "print(parks)"
   ]
