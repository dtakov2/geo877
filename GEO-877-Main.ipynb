    "        # Check for intersection\n",
    "        elif sutherland_hodgman(water_geom, park_geom):\n",
    "            return park_row['pflegeareal']\n",
    "    return None\n",
    "\n",
    "# Apply to associate parks\n",
    "water_df_processed['related_park'] = water_df_processed['geometry'].apply(\n",
