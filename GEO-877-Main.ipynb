    "def check_wc_in_park(park_polygon, wc_points):\n",
    "    # Check if any WC point is inside the park polygon\n",
    "    for wc in wc_points:\n",
    "        if park_polygon.containsPoint(wc):\n",
    "            return \"Yes\"\n",
    "    return \"No\"\n",
    "\n",
    "# Extract WC geometries as Point objects (ensure WC data is in Point form)\n",
    "wc_points = [Point(wc.x, wc.y) for wc in gdf_wc.geometry]\n",
    "\n",
    "# Create a new column in the parks DataFrame to store the result\n",
    "dfParks_combined['WC'] = dfParks_combined['parsed_geometry'].apply(\n",
    "    lambda park_geom: check_wc_in_park(Polygon(data=park_geom, xcol=0, ycol=1), wc_points)\n",
    ")\n",
    "\n",
    "parks_with_wc = dfParks_combined[dfParks_combined['WC'] == 'Yes']\n",
    "\n",
    "print(parks_with_wc[['pflegeareal', 'poly_area', 'WC']].head())\n",
    "\n",
    "# View the updated parks DataFrame with the new column\n",
    "print(dfParks_combined[['pflegeareal', 'WC']].head())\n",
    "\n",
    "\n"
