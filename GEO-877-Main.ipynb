    "from geospatial import Polygon as GeoPolygon, Point as GeoPoint\n",
    "\n",
    "# Helper to convert Shapely geometry to list of (x, y) tuples\n",
    "def shapely_to_tuples(geom):\n",
    "    if geom.geom_type == 'Polygon':\n",
    "        return list(geom.exterior.coords)\n",
    "    elif geom.geom_type == 'MultiPolygon':\n",
    "        # Flatten all exterior coords from all polygons\n",
    "        coords = []\n",
    "        for poly in geom.geoms:\n",
    "            coords.extend(list(poly.exterior.coords))\n",
    "        return coords\n",
    "    else:\n",
    "        return []"
   ]
