    "def filter_low_compactness(geodataframe, min_compactness=0.125):\n",
    "    \n",
    "    # Calculate compactness\n",
    "    geodataframe['compactness'] = (4 * np.pi * geodataframe['geometry'].area) / (geodataframe['geometry'].length ** 2)\n",
    "    \n",
    "    # Filter polygons based on compactness\n",
    "    filtered_geodataframe = geodataframe[geodataframe['compactness'] >= min_compactness]\n",
    "    return filtered_geodataframe\n",
    "\n",
    "# Apply the function to filter polygons in proto_combined\n",
    "filtered_parks_combined = filter_low_compactness(parks_combined)\n",
    "\n",
    "# Display the filtered GeoDataFrame\n",
    "print(filtered_parks_combined)"
